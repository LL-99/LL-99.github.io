	<MudPaper Class="page-intro pa-4" Elevation="0" Outlined="true">
		<MudText Typo="Typo.body1">
			These are the projects I have been working on by myself. 
			There are quite a few more prototypes/tiny fun projects I've made over the years, but listing them all here would get quite boring, so instead I want to focus on the notable ones.
		</MudText>
	</MudPaper>

	<ProjectGrid ProjectGroup="@Services.ProjectGroup.Own" />

	<ProjectList ProjectGroup="@Services.ProjectGroup.Own" />
</MudStack>


