@using Helpers
@using MudBlazor
@using Services

@page "/Portfolio"

@inject ContentService ContentService

<MudDivider Class="my-5" />

<MudText Typo="Typo.h4" Align="Align.Center">Welcome!</MudText>
<MudText Typo="Typo.body1" Align="Align.Center">Hi, I'm Lucas! Welcome my homepage! Below you can find my portfolio containing many of my projects. Feel free to take a look around.</MudText>
<MudText Typo="Typo.body2" Align="Align.Center">Please be aware that this page is still WIP, as I've recently been busy with migrating it from plain HTML to MudBlazor.</MudText>

<div style="height:5px" />

<MudContainer Class="home-page-grid pt-4 px-0">
	@foreach (var cell in GridCells)
	{
		<MudPaper Class="@cell.CssClass" Style=@cell.CssStyle>
			@if (cell.Images == null || cell.Images.Count == 0)
			{
				if (string.IsNullOrWhiteSpace(cell.Title) && string.IsNullOrWhiteSpace(cell.Descr))
				{
					<MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" />
				}
				else
				{
					<MudPaper class="pa-5" Style="height:100%; align-content:center">
						@if (string.IsNullOrWhiteSpace(cell.Title) == false)
						{
							<MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight:bold">@cell.Title</MudText>
							<MudDivider Class="my-2" />
						}
						@if (string.IsNullOrWhiteSpace(cell.Descr) == false)
						{
							<MudText Typo="Typo.body1" Align="Align.Justify">@((MarkupString)cell.Descr)</MudText>
						}
						@if(string.IsNullOrWhiteSpace(cell.Link) == false)
						{
							<MudText Typo="Typo.body1" Align="Align.Left"><a href=@cell.Link>Learn more</a></MudText>							
						}
					</MudPaper>
				}

			}
			else if (cell.Images.Count == 1)
			{
				<MudPaper class="d-flex justify-content-center" style="width:stretch;height:100%;">
					<MudImage Src="@cell.Images.First()" Elevation="25" Class="rounded-lg" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
				</MudPaper>
			}
			else
			{
				<MudCarousel Class="mud-width-full rounded-lg" Style="height:100%;" ShowArrows ShowBullets EnableSwipeGesture AutoCycle TData="object">
					@foreach (var img in cell.Images)
					{
						<MudCarouselItem Class="rounded-lg" Transition="Transition.Slide" Color="@Color.Primary">
							<MudPaper class="d-flex justify-content-center" style="width:stretch;height:100%;">
								<MudImage Src="@img" Class="rounded-0" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
							</MudPaper>
						</MudCarouselItem>
					}
				</MudCarousel>
			}

		</MudPaper>
	}
</MudContainer>

<div style="height:100px" />

<style>
	.home-page-grid {
		display: grid;
		gap: 25px;
		grid-template-columns: repeat(12, 1fr);
		grid-auto-rows: 100px;
		height: contain;
		width: 100%;
	}
</style>


@code {

	public List<DynamicGridCell> GridCells { get; set; } = [];
	public List<HomePageProjectDefinition> Projects { get; } = [];

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		GridCells.Clear();
		StateHasChanged();

		var proj = await ContentService.GetHomePageProjects();

		GridCells = proj.SelectMany(x => x.InvertOrder == false ?
			new List<DynamicGridCell>() { x.ImageCell, x.DescrCell } :
			new List<DynamicGridCell>() { x.DescrCell, x.ImageCell })
			.ToList();
		StateHasChanged();
	}
}
