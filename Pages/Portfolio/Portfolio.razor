@using Helpers
@using MudBlazor
@using Services

@page "/Portfolio"

@inject ContentService ContentService

<MudPaper Class="portfolio-hero pa-5 mb-5" Elevation="0" Outlined="true">
	<MudText Typo="Typo.h4" Align="Align.Center">Welcome!</MudText>
	<MudText Typo="Typo.body1" Align="Align.Center">Hi, I'm Lucas! Welcome my homepage! Below you can find my portfolio containing many of my projects. Feel free to take a look around.</MudText>
	<MudText Typo="Typo.body2" Align="Align.Center">Please be aware that this page is still WIP, as I've recently been busy with migrating it from plain HTML to MudBlazor.</MudText>
</MudPaper>

<MudStack Spacing="4" Class="portfolio-categories">
	@foreach (var project in Projects)
	{
		<section class="portfolio-category">
			@foreach (var cell in OrderedCells(project))
			{
				<div class="@($"portfolio-category-cell {(cell.Images == null ? "portfolio-copy" : "portfolio-media")}")" style="grid-column: span @cell.SizeX;">
					@if (cell.Images == null || cell.Images.Count == 0)
					{
						if (string.IsNullOrWhiteSpace(cell.Title) && string.IsNullOrWhiteSpace(cell.Descr))
						{
							<MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100%" Width="100%" />
						}
						else
						{
							@if (string.IsNullOrWhiteSpace(cell.Title) == false)
							{
								<MudText Typo="Typo.h5" Style="font-weight:bold">@cell.Title</MudText>
								<MudDivider Class="my-2" />
							}
							@if (string.IsNullOrWhiteSpace(cell.Descr) == false)
							{
								<MudText Typo="Typo.body1">@((MarkupString)cell.Descr)</MudText>
							}
							@if (string.IsNullOrWhiteSpace(cell.Link) == false)
							{
								<MudButton Class="mt-3 align-self-start" Href="@cell.Link" Variant="Variant.Text" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">Learn more</MudButton>
							}
						}
					}
					else if (cell.Images.Count == 1)
					{
						<MudImage Src="@cell.Images.First()" Class="portfolio-tile-image" ObjectFit="ObjectFit.Cover" Style="width: 100%;" />
					}
					else
					{
						<MudCarousel Class="mud-width-full portfolio-carousel" ShowArrows ShowBullets EnableSwipeGesture AutoCycle TData="object">
							@foreach (var img in cell.Images)
							{
								<MudCarouselItem Transition="Transition.Slide" Color="@Color.Primary">
									<MudImage Src="@img" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%;" />
								</MudCarouselItem>
							}
						</MudCarousel>
					}

				</div>
			}
		</section>
	}
</MudStack>

<div style="height:100px" />

@code {
	public List<HomePageProjectDefinition> Projects { get; } = [];

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		Projects.Clear();
		StateHasChanged();

		var proj = await ContentService.GetHomePageProjects();

		Projects.AddRange(proj);
		StateHasChanged();
	}

	private static IEnumerable<DynamicGridCell> OrderedCells(HomePageProjectDefinition project) =>
		project.InvertOrder == false
			? [project.ImageCell, project.DescrCell]
			: [project.DescrCell, project.ImageCell];
}
