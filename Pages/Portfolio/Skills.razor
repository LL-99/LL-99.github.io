@code {
	private class SkillCategory
	{
		public string CategoryName { get; set; }
		public List<SkillLevel> SkillLevels { get; set; }
	}

	private class SkillLevel
	{
		public int Level { get; set; }
		public List<string> Skills { get; set; }

		public SkillLevel(int level, List<string> skills)
		{
			Level = level;
			Skills = skills;
		}
	}

	private IEnumerable<SkillCategory> SkillCategories = [
		new() {
			CategoryName = "Communication Skills",
			SkillLevels = [
				new(5, [ "Interpersonal communication", "Teamwork"])
			]
		}
	];
}
