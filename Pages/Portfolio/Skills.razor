<MudTable Items="@SkillCategories">
@* 	<HeaderContent>
		<MudTh>Category</MudTh>
		<MudTh>Skill Level</MudTh>
		<MudTh>Skill</MudTh>
	</HeaderContent> *@

	<ColGroup>
		<col style="width: 45%;" />
		<col />
		<col />
	</ColGroup>
	<RowTemplate>
		<MudTd>@context.CategoryName</MudTd>
		<MudTd>
			@foreach (var skillLevel in context.SkillLevels)
			{
				<MudStack Row>
					<MudRating ReadOnly SelectedValue="@skillLevel.Level" MaxValue="4" Style="pointer-events:none;" />
					<MudText>@skillLevel.Skills.Aggregate((a, b) => a + "," + b)</MudText>
				</MudStack>
			}
		</MudTd>
	</RowTemplate>
</MudTable>

<table id="skills-table-new">
	<!-- Category I -->
	<tr class="category-definition">
		<td rowspan="4" style="width: 47.5%;">
			Programming languages, markup languages, domain-specific languages, etc.
		</td>
		<MudRating ReadOnly SelectedValue="4" MaxValue="4" Style="pointer-events:none;" />
		<td>C# (+LINQ)</td>
