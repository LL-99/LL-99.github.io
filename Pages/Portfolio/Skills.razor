@page "/Portfolio/Skills"
@using MudBlazor

<MudStack Spacing="4">
	<MudText Typo="Typo.h3" Align="Align.Center">Skills</MudText>
	<MudText Typo="Typo.h6"><i>Thank you for any offers, but I'm currently not looking for a new position!</i></MudText>

	<MudPaper Class="page-intro pa-4" Elevation="0" Outlined="true">
		<MudStack Spacing="3">
			<MudText Typo="Typo.body1">
				As you may have seen on my main <MudLink href="Portfolio">portfolio page</MudLink> I have worked on a number of different projects.<br />
				This has allowed me to pick up skills on a lot of topics I like & I'm interested in.<br />
				In case you are looking for someone to fill a gap on your team and think I possess the necessary skills, please get in contact with me via my email <a href="mailto:lucas.leder99@gmail.com" target="_blank" rel="noopener noreferrer">lucas.leder99@gmail.com</a>.
				I'm also always excited to learn new things and further my proficiency in skills I have already picked up!
			</MudText>
		</MudStack>
	</MudPaper>

	<MudGrid Spacing="4">
		@foreach (var category in SkillCategories)
		{
			<MudItem xs="12" md="6">
				<MudPaper Class="skill-panel pa-4 h-100" Elevation="0" Outlined="true">
					<MudStack Spacing="3">
						<MudText Typo="Typo.h6">@category.CategoryName</MudText>
						@foreach (var skillLevel in category.SkillLevels)
						{
							<MudStack Class="skill-level" Spacing="1">
								<MudRating ReadOnly SelectedValue="@skillLevel.Level" MaxValue="4" Size="Size.Small" Style="pointer-events:none;" />
								<MudText Typo="Typo.body2">@string.Join(", ", skillLevel.Skills)</MudText>
							</MudStack>
						}
					</MudStack>
				</MudPaper>
			</MudItem>
		}
	</MudGrid>

	<MudPaper Class="page-intro pa-4 mb-8" Elevation="0" Outlined="true">
		<MudGrid Spacing="2">
			@foreach (var legend in SkillLegend)
			{
				<MudItem xs="12" sm="6" md="3">
					<MudStack Spacing="1" AlignItems="AlignItems.Center">
						<MudRating ReadOnly SelectedValue="@legend.Level" MaxValue="4" Size="Size.Small" Style="pointer-events:none;" />
						<MudText Typo="Typo.body2" Align="Align.Center">@legend.Label</MudText>
					</MudStack>
				</MudItem>
			}
		</MudGrid>
	</MudPaper>
</MudStack>

@code {
	private sealed class SkillCategory
	{
		public required string CategoryName { get; set; }
		public required List<SkillLevel> SkillLevels { get; set; }
	}

	private sealed class SkillLevel(int level, List<string> skills)
	{
		public int Level { get; } = level;
		public List<string> Skills { get; } = skills;
	}

	private sealed class SkillLegendEntry(int level, string label)
	{
		public int Level { get; } = level;
		public string Label { get; } = label;
	}

	private readonly List<SkillCategory> SkillCategories =
	[
		new()
		{
			CategoryName = "Programming languages, markup languages, domain-specific languages, etc.",
			SkillLevels =
			[
				new(4, ["C# (+LINQ)"]),
				new(4, ["HTML", "CSS", "JS", "C++", "Java", "Python", "R"]),
				new(2, ["jQuery", "XML & XQuery", "SQL"]),
				new(1, ["HLSL & GLSL", "Assembly"])
			]
		},
		new()
		{
			CategoryName = "Communication Skills",
			SkillLevels =
			[
				new(4, ["Interpersonal communication", "Teamwork"]),
				new(3, ["Presentation skills"]),
				new(2, ["Project management"])
			]
		},
		new()
		{
			CategoryName = "Electronic Data Processing",
			SkillLevels =
			[
				new(4, ["Data Management"]),
				new(3, ["Image editing (GIMP)", "Text creation & editing (Microsoft Word, PowerPoint, etc.)", "Tables and databases (Microsoft Excel, etc.)"])
			]
		},
		new()
		{
			CategoryName = "Software and Game Development",
