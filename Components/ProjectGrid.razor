@using Helpers
@using MudBlazor
@using Services

@inject ContentService ContentService
@inject NavigationManager NavigationManager

<MudGrid Spacing="4" Class="project-grid" Justify="Justify.Center">
	@foreach (var project in Projects)
	{
		<MudItem xs="12" sm="6" lg="5">
			<MudPaper Class="project-card" Elevation="8">
				<div class="project-card-media">
					@if (project.IsVideo == false)
					{
						<MudImage Src="@project.Thumbnail" ObjectFit="ObjectFit.Cover" Style="width:100%; height:100%;" />
					}
					else
					{
						<video style="width:100%; height:100%; object-fit:cover;" autoplay muted loop>
							<source src="@project.Thumbnail" type="video/mp4" />
						</video>
					}
				</div>

				<MudOverlay Class="project-card-overlay pa-5" Visible="true" DarkBackground="true" Absolute="true">
					<MudStack Spacing="2" AlignItems="AlignItems.Center" Justify="Justify.Center" Class="h-100">
						<MudText Typo="Typo.h5" Align="Align.Center">@project.Name</MudText>
						<MudText Typo="Typo.body2" Align="Align.Center">@project.Summary</MudText>
						<MudButton Href="@ProjectHref(project)" Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward">Click here to learn more</MudButton>
					</MudStack>
				</MudOverlay>
			</MudPaper>
		</MudItem>
	}
</MudGrid>

@code {
	[Parameter]
	public ProjectGroup ProjectGroup { get; set; }

	public int ProjectCardHeight { get; set; } = 500;
	public List<DetailedProjectDefinition> Projects { get; set; } = [];

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();

		Console.WriteLine("Loading project grid for group " + ProjectGroup);
		Projects = await ContentService.GetProjectsForGroup(ProjectGroup);
		StateHasChanged();
	}

	private string ProjectHref(DetailedProjectDefinition project)
	{
		var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('?', '#')[0].TrimStart('/');
		return "/" + relativePath + "#" + ProjectAnchor(project);
	}

	private static string ProjectAnchor(DetailedProjectDefinition project) =>
		NormalizeAnchor(project.LocalUrl) ?? Slug(project.Name);

	private static string? NormalizeAnchor(string? anchor) =>
		string.IsNullOrWhiteSpace(anchor) ? null : anchor.Trim().TrimStart('#');

	private static string Slug(string? value)
	{
		var result = new string((value ?? "project").ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
		while (result.Contains("--"))
		{
			result = result.Replace("--", "-");
		}

		return result.Trim('-');
	}
}
