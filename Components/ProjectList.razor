@using Helpers
@using MudBlazor
@using Services

@inject ContentService ContentService

@foreach (var project in Projects)
{
	var primaryAnchor = PrimaryAnchor(project);
	<MudPaper id="@primaryAnchor" Class="project-detail-section pa-4 pa-sm-6 my-8" Elevation="0" Outlined="true">

		@foreach (var anchorId in AnchorIds(project).Where(id => id != primaryAnchor))
		{
			<span id="@anchorId" class="project-anchor"></span>
		}

		<MudText Typo="Typo.h4">@(string.IsNullOrWhiteSpace(project.NameLong) ? project.Name : project.NameLong)</MudText>
		<MudDivider Class="my-3" />

		@if (project.Description != null && project.Description.Count > 0)
		{
			foreach (var descr in project.Description)
			{
				@if (string.IsNullOrWhiteSpace(descr.Text) == false)
				{
					<MudText Typo="Typo.body1" Class="mb-4">@((MarkupString)descr.Text)</MudText>
				}

				@if (descr.ShowcaseElements != null && descr.ShowcaseElements.Count > 0)
				{
					<MudPaper Class="showcase-frame my-5" Elevation="0">
						<MudCarousel Class="mud-width-full showcase-carousel"
									 ShowArrows="@(descr.ShowcaseElements.Count > 1)"
									 ShowBullets="@(descr.ShowcaseElements.Count > 1)"
									 EnableSwipeGesture
									 AutoCycle
									 TData="object"
									 @bind-SelectedIndex="SelectedShowcaseIndex[descr]">
							@foreach (var element in descr.ShowcaseElements)
							{
								<MudCarouselItem Transition="Transition.Slide" Color="@Color.Primary">
									<div class="showcase-media">
										@if (element.IsVideo == false)
										{
											<MudImage Src="@element.Source" ObjectFit="ObjectFit.ScaleDown" Style="width:100%; height:100%;" />
										}
										else
										{
											<video style="width:100%; height:100%; object-fit:contain;" autoplay muted loop>
												<source src="@element.Source" type="video/mp4" />
											</video>
										}
									</div>
								</MudCarouselItem>
							}
						</MudCarousel>

						<MudText Typo="Typo.subtitle2" Align="Align.Center" Class="showcase-caption px-3 py-3">@descr.ShowcaseElements[SelectedShowcaseIndex[descr]].Caption</MudText>
					</MudPaper>
				}
			}
		}
	</MudPaper>
}

@code {
	[Parameter]
	public ProjectGroup ProjectGroup { get; set; }

	public List<DetailedProjectDefinition> Projects { get; set; } = [];
	public Dictionary<ProjectDescriptor, int> SelectedShowcaseIndex { get; set; } = new();


	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();

		Projects = await ContentService.GetProjectsForGroup(ProjectGroup);
		SelectedShowcaseIndex = Projects.SelectMany(x => x.Description ?? new()).Select(x => KeyValuePair.Create(x, 0)).ToDictionary();

		StateHasChanged();
	}

	private static IEnumerable<string> AnchorIds(DetailedProjectDefinition project)
	{
		var ids = new List<string>();
		var configured = PrimaryAnchor(project);
		var slug = Slug(project.Name);

		if (string.IsNullOrWhiteSpace(configured) == false)
		{
			ids.Add(configured);
			if (configured.StartsWith("project-") == false)
			{
				ids.Add("project-" + configured);
			}
		}

		ids.Add(slug);
		ids.Add("project-" + slug);

		return ids.Distinct();
	}

	private static string PrimaryAnchor(DetailedProjectDefinition project) =>
		NormalizeAnchor(project.LocalUrl) ?? Slug(project.Name);

	private static string? NormalizeAnchor(string? anchor) =>
		string.IsNullOrWhiteSpace(anchor) ? null : anchor.Trim().TrimStart('#');

	private static string Slug(string? value)
	{
		var result = new string((value ?? "project").ToLowerInvariant().Select(c => char.IsLetterOrDigit(c) ? c : '-').ToArray());
		while (result.Contains("--"))
		{
			result = result.Replace("--", "-");
		}

		return result.Trim('-');
	}
}
