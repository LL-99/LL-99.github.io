@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider @ref="_provider" @bind-IsDarkMode="_isDark" Theme="@_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
	<MudAppBar Elevation="0">
		<MudIconButton Icon="@(_isDark? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
					   OnClick="ToggleTheme"
					   AriaLabel="Toggle dark/light" />
	</MudAppBar>

	<MudMainContent Class="d-flex align-content-center justify-content-center">
		<MudContainer MaxWidth="MaxWidth.Medium" Class="pt-5">
			@Body
		</MudContainer>
	</MudMainContent>
</MudLayout>

@code {
	private bool _isDark = true;                 // Default to dark
	private MudThemeProvider? _provider;
	private MudTheme _theme = new();             // Default MudBlazor theme

	private void ToggleTheme() => _isDark = !_isDark;

	// Optional: respect OS preference on first render
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && _provider is not null)
		{
			// var prefersDark = await _provider.GetSystemDarkModeAsync();
			// _isDark = prefersDark;                   // Update to system preference
			_isDark = true;
			StateHasChanged();
		}
	}
}