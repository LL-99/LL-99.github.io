@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider @ref="_provider" @bind-IsDarkMode="_isDark" Theme="@_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
	<MudAppBar Elevation="1" Class="site-appbar px-2">
		<MudIconButton Icon="@(_isDark? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
					   OnClick="ToggleTheme"
					   aria-label="Toggle dark/light" />
	</MudAppBar>

	<MudMainContent Class="site-main">
		<MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 px-4">
			@Body
		</MudContainer>
	</MudMainContent>
</MudLayout>

@code {
	private bool _isDark = true;                 // Default to dark
	private MudThemeProvider? _provider;
	private MudTheme _theme = new()
	{
		PaletteLight = new PaletteLight()
		{
			Primary = "#3758f9",
			Secondary = "#00a896",
			Tertiary = "#f59e0b",
			Background = "#f6f8fb",
			Surface = "#ffffff",
			AppbarBackground = "#ffffff",
			AppbarText = "#172033",
			TextPrimary = "#172033",
			TextSecondary = "#5d6b82",
			LinesDefault = "#dbe4f0"
		},
		PaletteDark = new PaletteDark()
		{
			Primary = "#8ea2ff",
			Secondary = "#4dd7c8",
			Tertiary = "#ffcb6b",
			Background = "#0b1020",
			Surface = "#121a2b",
			AppbarBackground = "#0f172a",
			AppbarText = "#f8fafc",
			TextPrimary = "#f8fafc",
			TextSecondary = "#c5d0e2",
			LinesDefault = "#273449"
		}
	};

	private void ToggleTheme() => _isDark = !_isDark;

	// Optional: respect OS preference on first render
	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && _provider is not null)
		{
			// var prefersDark = await _provider.GetSystemDarkModeAsync();
			// _isDark = prefersDark;                   // Update to system preference
			_isDark = true;
			StateHasChanged();
		}
	}
}
